# Copy to .env at the repo root if you need to override defaults.
# Host ports avoid collisions with other local stacks (aipack, docuforge, econsulat).

# PostgreSQL (host 5438 → container 5432)
POSTGRES_DB=konselyavisa
POSTGRES_USER=konselyavisa
POSTGRES_PASSWORD=konselyavisa
POSTGRES_PORT=5438

# App JDBC user (non-superuser, subject to RLS). Created by Flyway V2.
# Flyway itself still connects as POSTGRES_USER.

# Redis (host 6388 → container 6379)
REDIS_PORT=6388

# Keycloak (admin console: http://localhost:8081)
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_HOSTNAME=http://localhost:8081

# Realm / clients (must match infrastructure/keycloak/konselyavisa-realm.json)
KEYCLOAK_REALM=konselyavisa
OIDC_ISSUER=http://localhost:8081/realms/konselyavisa
OIDC_INTERNAL_ISSUER=http://keycloak:8080/realms/konselyavisa

# Demo users (imported with the realm)
#   citizen.dev / CitizenDev!23   role CITIZEN          org 11111111-1111-1111-1111-111111111111
#   company.dev / CompanyDev!23   role COMPANY_USER     same org
#   company.admin.dev / CompanyAdminDev!23  COMPANY_USER + BUSINESS_ADMIN
#   agent.dev   / AgentDev!23     role AGENT            same org
#   admin.dev   / AdminDev!23     role PLATFORM_ADMIN   no organization_id

# MinIO (console: http://localhost:9011)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minioDevPass1
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011

# Backend API (direct: http://localhost:18083 — nginx gateway: http://localhost:18080)
BACKEND_PORT=18083
NGINX_PORT=18080

# Observability
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
TEMPO_PORT=13200

# Mailpit (UI: http://localhost:8029)
MAILPIT_SMTP_PORT=1029
MAILPIT_UI_PORT=8029

# OpenTelemetry collector
OTEL_GRPC_PORT=14317
OTEL_HTTP_PORT=14318

# n8n UI: http://localhost:15678 (n8n@konselyavisa.local / N8nDev!23)
# Outbox webhook (backend → n8n, then Mailpit http://localhost:8029)
N8N_PORT=15678
KONSELYAVISA_OUTBOX_WEBHOOK_URL=http://n8n:5678/webhook/konselyavisa-outbox
KONSELYAVISA_OUTBOX_WEBHOOK_SECRET=konselya-outbox-dev
N8N_OWNER_EMAIL=n8n@konselyavisa.local
N8N_OWNER_PASSWORD=N8nDev!23
KONSELYAVISA_NOTIFY_TO=notify@konselyavisa.local

# Stripe (leave empty to keep MOCK). Set organization_settings.paymentProvider to "STRIPE".
# Forward webhooks: stripe listen --forward-to localhost:18083/api/v1/payments/webhooks/STRIPE
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5175/?stripe=success
STRIPE_CANCEL_URL=http://localhost:5175/?stripe=cancel

# CinetPay (leave empty to keep MOCK). Set organization_settings.paymentProvider to "CINETPAY"
# and feature flag payment.provider.CINETPAY (demo org is on, global is off).
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_NOTIFY_URL=http://localhost:18083/api/v1/payments/webhooks/CINETPAY
CINETPAY_RETURN_URL=http://localhost:5175/?cinetpay=return
