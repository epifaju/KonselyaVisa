{
  "realm": "konselyavisa",
  "enabled": true,
  "displayName": "KonselyaVisa",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "pt", "en"],
  "defaultLocale": "fr",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      { "name": "CITIZEN", "description": "Portail citoyen" },
      { "name": "COMPANY_USER", "description": "Utilisateur entreprise / mandataire" },
      { "name": "AGENT", "description": "Agent consulaire" },
      { "name": "SUPERVISOR", "description": "Superviseur" },
      { "name": "BUSINESS_ADMIN", "description": "Administrateur métier d'une organisation" },
      { "name": "PLATFORM_ADMIN", "description": "Administrateur plateforme (cross-tenant)" }
    ]
  },
  "attributes": {
    "frontendUrl": "http://localhost:8081"
  },
  "clients": [
    {
      "clientId": "citizen-portal",
      "name": "Citizen portal",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:5175",
      "baseUrl": "http://localhost:5175",
      "redirectUris": ["http://localhost:5175/*"],
      "webOrigins": ["http://localhost:5175"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5175/*"
      },
      "defaultClientScopes": ["web-origins", "acr", "basic", "profile", "roles", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access"],
      "protocolMappers": [
        {
          "name": "organization_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "organization_id",
            "claim.name": "organization_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
